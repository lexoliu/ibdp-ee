# Email notification configuration using Resend API
# Set EMAIL_NOTIFICATIONS=true to enable email notifications

# Enable/disable email notifications
EMAIL_NOTIFICATIONS=false

# Resend API key (required if notifications are enabled)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# From email address (must be verified in your Resend account)
RESEND_FROM_EMAIL=benchmark@yourdomain.com

# Comma-separated list of email addresses to receive notifications
RESEND_TO_EMAILS=admin@yourdomain.com,team@yourdomain.com

# Optional: Override server log level for benchmark services
SERVER_LOG=0

# Optional: Override benchmark mode (debug for 2s tests, normal for 5m tests)
MODE=normal

# Optional: Override number of virtual users for k6
VUS=64

# Optional: Override base URL for benchmarks
BASE_URL=http://127.0.0.1:8080